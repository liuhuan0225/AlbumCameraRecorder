<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="60dp"
    android:layout_height="60dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivSelectedMedia"
        style="@style/ShapeableImageView.NoStroke"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|start"
        android:contentDescription="@string/z_multi_library_show_thumbnails"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.SelectedMediaThumbnail" />

    <ImageView
        android:id="@+id/ivRemoveSelectedMedia"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="top|end"
        android:contentDescription="@string/z_multi_library_delete_button"
        android:src="@drawable/ic_selected_media_delete_zjh" />

    <FrameLayout
        android:id="@+id/flVideoDuration"
        android:layout_width="56dp"
        android:layout_height="24dp"
        android:layout_gravity="bottom|start"
        android:background="@drawable/bg_selected_video_duration_zjh"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvSelectedVideoDuration"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="4dp"
            android:gravity="center_vertical"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            tools:ignore="HardcodedText"
            tools:text="08:12" />

    </FrameLayout>

    <View
        android:id="@+id/viewDeselectedMask"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|start"
        android:background="@drawable/bg_selected_media_mask"
        android:visibility="gone" />

    <View
        android:id="@+id/viewCurrentPreviewBorder"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|start"
        android:background="@drawable/bg_preview_selected_media_border"
        android:visibility="gone" />

</FrameLayout>
