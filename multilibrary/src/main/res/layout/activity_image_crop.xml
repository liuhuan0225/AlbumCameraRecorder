<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/crop_background">

    <com.zhongjh.multimedia.crop.CropGestureImageView
        android:id="@+id/imageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <com.zhongjh.multimedia.crop.CropOverlayView
        android:id="@+id/cropOverlayView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <View
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/crop_top_bar_height"
        android:background="@color/crop_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/buttonBack"
        android:layout_width="@dimen/crop_back_button_size"
        android:layout_height="@dimen/crop_back_button_size"
        android:layout_marginStart="@dimen/crop_page_margin"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/z_multi_library_crop_back"
        android:scaleType="centerInside"
        android:src="@drawable/ic_back"
        app:layout_constraintBottom_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarSpace" />

    <Space
        android:id="@+id/statusBarSpace"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="@id/topBar"
        app:layout_constraintTop_toTopOf="@id/topBar" />

    <Button
        android:id="@+id/buttonConfirm"
        android:layout_width="0dp"
        android:layout_height="@dimen/crop_button_height"
        android:layout_marginStart="@dimen/crop_page_margin"
        android:layout_marginEnd="@dimen/crop_page_margin"
        android:layout_marginBottom="@dimen/crop_button_margin_bottom"
        android:background="@drawable/bg_crop_confirm"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:lineSpacingExtra="4sp"
        android:text="@string/z_multi_library_confirm"
        android:textColor="@color/white"
        android:textSize="@dimen/crop_button_text_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/crop_bottom_bar_height"
        android:background="@color/crop_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
