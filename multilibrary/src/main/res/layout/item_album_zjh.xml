<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="86dp"
    android:background="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingVertical="8dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgFirst"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_centerVertical="true"
        android:background="@drawable/album_spinner_thumbnail_bg"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.AlbumSpinner.Thumbnail"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/tvSign"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_alignEnd="@id/imgFirst"
        android:layout_margin="4dp"
        android:background="@drawable/ic_orange_oval"
        android:visibility="invisible" />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="10dp"
        android:layout_toEndOf="@id/imgFirst"
        android:layout_centerVertical="true"
        >
        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="16sp"
            tools:text="ALL" />

        <TextView
            android:id="@+id/tvCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="#99FFFFFF"
            android:layout_marginTop="5dp"
            android:textSize="12sp"
            tools:text="102" />
    </LinearLayout>


</RelativeLayout>
